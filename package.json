{
  "name": "dsh-ssh-remote",
  "version": "0.4.0",
  "description": "Remote workspaces for DeepSeek Harness: deploy and supervise a persistent dsh runtime on an SSH host, WSL distribution or Docker container, project it into the native workspace list, chat from the local app, and open the remote DSH in your own browser.",
  "license": "MIT",
  "author": "longguanhong0755",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longguanhong0755/dsh-ssh.git"
  },
  "homepage": "https://github.com/longguanhong0755/dsh-ssh#readme",
  "bugs": {
    "url": "https://github.com/longguanhong0755/dsh-ssh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-ssh-install": "./bin/install.mjs",
    "dsh-ssh-uninstall": "./bin/uninstall.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "scan": "node scripts/session-scan.mjs",
    "doctor": "node scripts/anchor-doctor.mjs",
    "repack": "node scripts/anchor-repack.mjs",
    "build:client": "node scripts/build-client.mjs",
    "docs:errors": "node scripts/errors-doc.mjs",
    "styles": "node scripts/classes.mjs",
    "test": "node --test",
    "e2e:live": "node scripts/e2e-live.mjs",
    "e2e:lock": "node scripts/e2e-lock.mjs",
    "e2e:bridge": "node scripts/e2e-bridge.mjs",
    "reload": "node scripts/reload.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "!lib/client",
    "bin",
    "scripts",
    "docs/*.png",
    "docs/errors.md",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "ssh",
    "ssh-remote",
    "remote-workspace",
    "wsl",
    "docker",
    "remote-development"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
