{
  "name": "dsh-ssh-remote",
  "version": "0.3.1",
  "description": "ZCode-style SSH remote workspaces for DeepSeek Harness: deploy and supervise a persistent dsh runtime on an SSH host, project it into the native workspace list, and reopen recent remote directories in one click.",
  "license": "MIT",
  "author": "longguanhong0755",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longguanhong0755/dsh-ssh.git"
  },
  "homepage": "https://github.com/longguanhong0755/dsh-ssh#readme",
  "bugs": {
    "url": "https://github.com/longguanhong0755/dsh-ssh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-ssh-install": "./bin/install.mjs",
    "dsh-ssh-uninstall": "./bin/uninstall.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "scan": "node scripts/session-scan.mjs",
    "doctor": "node scripts/anchor-doctor.mjs",
    "repack": "node scripts/anchor-repack.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "!lib/client",
    "bin",
    "scripts",
    "docs/*.png",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "ssh",
    "ssh-remote",
    "remote-workspace",
    "wsl",
    "docker",
    "remote-development"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
